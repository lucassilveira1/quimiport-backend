  "description": "API de gestão de cargas químicas portuárias (Tech Challenge Fase 2 - Pós Tech Full Stack Development)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
