{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2022",
    "lib": ["esnext"],
    "types": ["node"],

    "esModuleInterop": true,
    "noImplicitAny": false,

    "sourceMap": true,
    "declaration": false,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "tests"]
}
