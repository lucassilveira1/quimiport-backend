# API
PORT=3000
NODE_ENV=development

# Banco de dados (Postgres)
POSTGRES_USER=quimiport
POSTGRES_PASSWORD=quimiport
POSTGRES_DB=quimiport
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Conexão da API com o banco quando a API roda fora do Docker (npm run dev).
# Dentro do Docker, o docker-compose sobrescreve isso apontando pro serviço "db"
# (ver "environment" do serviço api no docker-compose.yml).
DATABASE_URL=postgres://quimiport:quimiport@localhost:5432/quimiport